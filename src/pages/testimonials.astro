---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BookingCTA from '../components/BookingCTA.astro';
import { reviewParts } from '../lib/testimonials';

const items = (await getCollection('testimonials')).sort((a, b) => a.data.order - b.data.order);
// Projects can be deleted in /admin; only link to ones that still exist.
const projectIds = new Set((await getCollection('projects')).map((p) => p.id));
---
<Base
  title="Homeowner stories"
  description="Hear from clients who worked with Loft Concept, in their own words, and walk through Mimosa, a home we designed and built."
>
  <section class="container lead">
    <p class="eyebrow">Homeowner stories</p>
    <div class="lead__grid">
      <h1>The best way to understand our work <span class="accent">is to see it.</span></h1>
      <p class="lead__text">Clients on what it was like to work with us, in their own words, and a walk through one of the homes we designed and built.</p>
    </div>
  </section>

  <section class="container video" data-reveal>
    <video class="video__player" controls playsinline preload="none" poster="/videos/mimosa-poster.jpg" src="/videos/mimosa.mp4" aria-label="A walkthrough of Mimosa"></video>
    <div class="video__caption">
      <h2>A walkthrough of Mimosa</h2>
      <div class="video__text">
        <p>Step inside Mimosa, a home Loft Concept designed and built, and see the finished spaces room by room.</p>
        {projectIds.has('mimosa') && <a class="link" href="/portfolio/mimosa">View the project</a>}
      </div>
    </div>
  </section>

  <section class="container stories" aria-labelledby="stories-title">
    <h2 id="stories-title">What our clients say</h2>
    {items.map((item) => {
      const { pull, lead, visible, hidden } = reviewParts(item.data.quote, item.data.highlight);
      return (
      <figure class="story" data-reveal>
        <figcaption class="story__who">
          <strong>{item.data.author}</strong>
          {item.data.projectSlug && projectIds.has(item.data.projectSlug)
            ? <a class="link" href={`/portfolio/${item.data.projectSlug}`}>{item.data.projectLabel}</a>
            : <span>{item.data.projectLabel}</span>}
        </figcaption>
        <div class="story__words">
          {pull && <p class="story__lead accent" aria-hidden="true">“{pull}”</p>}
          <blockquote class="story__quote">
            {lead && <p class="story__lead accent">{lead}</p>}
            {visible.map((text) => <p>{text}</p>)}
            {hidden.length > 0 && (
              <details class="story__more">
                <summary><span class="link when-closed">Read the full review</span><span class="link when-open">Show less</span></summary>
                {hidden.map((text) => <p>{text}</p>)}
              </details>
            )}
          </blockquote>
        </div>
      </figure>
      );
    })}
  </section>

  <BookingCTA heading="Ready to get started?" />
</Base>

<style>
  .lead { padding-block: var(--s-6) var(--s-5); }
  .lead__grid { display: grid; gap: var(--s-3); }
  @media (min-width: 900px) { .lead__grid { grid-template-columns: 7fr 5fr; gap: var(--s-6); align-items: end; } }
  .lead h1 { max-width: 16ch; }
  .lead__text { font-size: var(--step-1); line-height: 1.5; color: var(--ink); max-width: 32ch; }

  .video__player { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--r-img); background: var(--ink); }
  .video__caption { display: grid; gap: var(--s-2); padding-top: var(--s-3); }
  @media (min-width: 900px) { .video__caption { grid-template-columns: 7fr 5fr; gap: var(--s-6); } }
  .video h2 { font-size: var(--step-2); }
  .video__text { display: grid; gap: var(--s-2); justify-items: start; }

  .stories { padding-block: var(--s-7) var(--s-6); }
  .stories h2 { margin-bottom: var(--s-5); }
  .story { margin: 0; display: grid; gap: var(--s-3); padding-block: var(--s-5); border-top: 1px solid color-mix(in srgb, var(--stone) 60%, transparent); }
  .story:last-of-type { border-bottom: 1px solid color-mix(in srgb, var(--stone) 60%, transparent); }
  @media (min-width: 900px) { .story { grid-template-columns: 4fr 8fr; gap: var(--s-6); align-items: first baseline; } }
  .story__who { display: grid; gap: 0.2rem; align-content: start; font-size: var(--step--1); letter-spacing: 0.03em; }
  .story__who strong { font-size: var(--step-0); font-weight: 500; color: var(--ink); letter-spacing: 0; }
  .story__words { display: grid; gap: var(--s-3); }
  .story__quote { margin: 0; max-width: 62ch; display: grid; gap: var(--s-2); }
  .story__lead { font-size: var(--step-2); line-height: 1.25; color: var(--ink); max-width: 30ch; margin-bottom: var(--s-1); }
  .story__more p + p { margin-top: var(--s-2); }
  .story__more summary { list-style: none; cursor: pointer; width: fit-content; }
  .story__more summary::-webkit-details-marker { display: none; }
  /* The disclosure needs to read as clickable before it is hovered. */
  .story__more summary .link { background-size: 100% 1px; }
  .story__more[open] summary { margin-bottom: var(--s-2); }
  .story__more .when-open, .story__more[open] .when-closed { display: none; }
  .story__more[open] .when-open { display: inline; }
</style>
