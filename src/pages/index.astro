---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Process from '../components/Process.astro';
import PullQuote from '../components/PullQuote.astro';
import BookingCTA from '../components/BookingCTA.astro';
import { localBusinessSchema } from '../lib/schema';

const featured = (await getCollection('projects', (p) => p.data.featured)).sort((a, b) => a.data.order - b.data.order).slice(0, 4);
// The client can delete projects in /admin: fall back to the sector's first project, or drop the panel.
const sectorPanel = async (sector: 'residential' | 'commercial', preferred: string) =>
  (await getEntry('projects', preferred)) ?? (await getCollection('projects', (p) => p.data.sector === sector)).sort((a, b) => a.data.order - b.data.order)[0];
const residential = await sectorPanel('residential', 'lornie-road');
const commercial = await sectorPanel('commercial', 'horse-city');
const quote = await getEntry('testimonials', 'wei-liang-priya');
if (!quote) throw new Error('Home page is missing a required content entry');

const excerpt = 'They really listened to how we live day to day and translated that into a space that just feels right.';
---
<Base
  title="Interior design and construction in Singapore"
  description="Loft Concept is a Singapore interior design and construction company. One team takes your HDB, condo, landed or commercial space from sketch to handover."
  schema={localBusinessSchema()}
>
  <section class="hero">
    <div class="hero__media">
      <video id="hero-video" data-ambient data-end-still autoplay muted playsinline preload="auto" poster="/videos/hero-poster.jpg" aria-hidden="true">
        <source src="/videos/hero.webm" type="video/webm" />
        <source src="/videos/hero.mp4" type="video/mp4" />
      </video>
      <script is:inline>
        (function () {
          var v = document.getElementById('hero-video');
          if (!v || !matchMedia('(max-aspect-ratio: 1/1)').matches) return;
          var s = v.querySelectorAll('source');
          s[0].src = '/videos/hero-portrait.webm';
          s[1].src = '/videos/hero-portrait.mp4';
          v.poster = '/videos/hero-poster-portrait.jpg';
          v.load();
        })();
      </script>
    </div>
    <div class="hero__veil"></div>
    <div class="container hero__copy">
      <p class="eyebrow">Interior design + construction · Singapore · Since 2010</p>
      <h1>Spaces designed <span class="accent">to last a lifetime.</span></h1>
      <a class="btn btn--invert" href="/contact">Book a consultation</a>
    </div>
  </section>

  <section class="section statement">
    <div class="container statement__grid">
      <p class="eyebrow">Design and build</p>
      <div data-reveal>
        <h2>Most design firms stop at the interior. <span class="accent">We carry on to the build.</span></h2>
        <p class="statement__body">Loft Concept pairs interior design with full-scale construction, so one accountable team takes your home from the first sketch to the final handover. HDB, condominium, landed or commercial, we bring both the vision and the capability to build it, backed by more than fifteen years of work since 2010.</p>
        <a class="link" href="/about">About the studio</a>
      </div>
    </div>
  </section>

  <section class="section work">
    <div class="container">
      <div class="work__head">
        <h2>Selected work</h2>
        <a class="link" href="/portfolio">All projects</a>
      </div>
      <div class="work__grid">
        {featured.map((project, i) => <ProjectCard project={project} eager={i === 0} />)}
      </div>
    </div>
  </section>

  <section class="section sectors">
    <div class="container">
      <h2 class="sectors__title">What we design</h2>
      <div class="sectors__grid">
        {residential && (
        <a class="sector" href="/portfolio?sector=residential" data-reveal>
          <div class="sector__media"><Photo image={residential.data.hero} alt={residential.data.heroAlt ?? 'A residential interior by Loft Concept'} sizes="(min-width: 900px) 50vw, 100vw" position={residential.data.coverPosition} /></div>
          <div class="sector__body">
            <h3>Residential</h3>
            <p>HDB, condominium and landed homes.</p>
            <span class="sector__cta">View projects</span>
          </div>
        </a>
        )}
        {commercial && (
        <a class="sector" href="/portfolio?sector=commercial" data-reveal style="--i:1">
          <div class="sector__media"><Photo image={commercial.data.hero} alt={commercial.data.heroAlt ?? 'A commercial interior by Loft Concept'} sizes="(min-width: 900px) 50vw, 100vw" position={commercial.data.coverPosition} /></div>
          <div class="sector__body">
            <h3>Commercial</h3>
            <p>Spaces built around a business.</p>
            <span class="sector__cta">View projects</span>
          </div>
        </a>
        )}
      </div>
    </div>
  </section>

  <Process />

  <section class="section">
    <div class="container">
      <PullQuote quote={excerpt} author={quote.data.author} label={quote.data.projectLabel} />
      <p class="more"><a class="link" href="/testimonials">More from our clients</a></p>
    </div>
  </section>

  <BookingCTA />
</Base>

<style>
  .hero { position: relative; min-height: calc(100dvh - var(--header-h)); display: grid; align-items: end; color: var(--white); overflow: hidden; }
  .hero__media, .hero__veil { position: absolute; inset: 0; }
  /* The video is a locked-off shot: the finished house sits in its middle, the road fills the bottom. Anchor low so a tall or wide
     viewport trims sky, never road, and keep the copy small and short enough to sit on the road, clear of the facade. */
  .hero__media video { width: 100%; height: 100%; object-fit: cover; object-position: 50% 92%; }
  .hero__veil { background: linear-gradient(to top, rgb(43 36 29 / 0.78), rgb(43 36 29 / 0.3) 32%, rgb(43 36 29 / 0) 58%); }
  .hero__copy { position: relative; display: grid; gap: 0.85rem; justify-items: start; padding-bottom: clamp(1.25rem, 4vh, 2.5rem); }
  .hero h1 { color: var(--white); font-size: clamp(1.9rem, 0.9rem + 4.4vw, 2.6rem); line-height: 1.05; max-width: 18ch; text-wrap: balance; }
  .hero .eyebrow { margin: 0; color: rgb(255 255 255 / 0.9); font-size: 0.7rem; line-height: 1.5; }
  @media (min-width: 700px) { .hero h1 { font-size: clamp(2.4rem, 1.1rem + 2.4vw, 3.6rem); max-width: none; } }
  @media (min-aspect-ratio: 4/5) and (max-aspect-ratio: 1/1) { .hero__media video { object-position: 50% 60%; } }
  @media (min-width: 1100px) and (min-aspect-ratio: 4/3) {
    .hero h1 { font-size: clamp(2.8rem, 1.2rem + 2.6vw, 4.5rem); }
    .hero__copy { grid-template-columns: minmax(0, 1fr) auto; align-items: end; column-gap: var(--s-4); }
    .hero .eyebrow { grid-column: 1 / -1; }
  }
  /* Very wide frames crop a lot of height: keep the roofline in view instead of anchoring to the road. */
  @media (min-aspect-ratio: 2/1) { .hero__media video { object-position: 50% 55%; } }
  @media (max-height: 520px) and (orientation: landscape) { .hero .eyebrow { display: none; } .hero h1 { font-size: 1.6rem; } .hero__media video { object-position: 50% 55%; } .hero__copy { grid-template-columns: minmax(0, 1fr) auto; align-items: end; column-gap: 1rem; padding-bottom: 1rem; } }
  @media (max-height: 700px) and (max-aspect-ratio: 1/1) { .hero .eyebrow { display: none; } }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .hero__media video { animation: hero-drift linear both; animation-timeline: scroll(root); animation-range: 0 100vh; }
    }
  }
  @keyframes hero-drift { to { transform: translateY(6%) scale(1.04); } }

  .statement__grid { display: grid; gap: var(--s-3); }
  @media (min-width: 900px) { .statement__grid { grid-template-columns: 3fr 9fr; } }
  .statement h2 { max-width: 20ch; }
  .statement__body { margin-block: var(--s-4) var(--s-3); }

  .work__head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: var(--s-5); }
  .work__grid { display: grid; gap: var(--s-5) var(--s-3); }
  @media (min-width: 900px) { .work__grid { grid-template-columns: 1fr 1fr; gap: var(--s-5) var(--s-3); } }

  .sectors__title { margin-bottom: var(--s-5); }
  .sectors__grid { display: grid; gap: var(--s-3); }
  @media (min-width: 900px) { .sectors__grid { grid-template-columns: 1fr 1fr; } }
  .sector { position: relative; display: block; overflow: hidden; border-radius: var(--r-img); color: var(--white); text-decoration: none; }
  .sector__media { position: relative; aspect-ratio: 4 / 5; }
  /* Legibility veil, same technique as the hero: dark where the text sits, light at the top. */
  .sector__media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgb(43 36 29 / 0.85), rgb(43 36 29 / 0.55) 40%, rgb(43 36 29 / 0.1) 75%); transition: opacity 0.6s var(--ease-out); }
  .sector:hover .sector__media::after { opacity: 0.85; }
  .sector__media :global(.photo) { transition: transform 1.1s var(--ease-out); }
  .sector:hover .sector__media :global(.photo) { transform: scale(1.02); }
  .sector__body { position: absolute; inset: auto 0 0; z-index: 1; display: grid; gap: 0.4rem; justify-items: start; padding: var(--s-3); }
  @media (min-width: 900px) { .sector__body { padding: var(--s-4); } }
  .sector h3 { color: var(--white); font-size: var(--step-3); }
  .sector p { color: rgb(255 255 255 / 0.9); }
  .sector__cta { margin-top: var(--s-2); padding-bottom: 2px; border-bottom: 1px solid currentColor; font-size: var(--step--1); letter-spacing: 0.04em; }
  .more { margin-top: var(--s-4); }
</style>
